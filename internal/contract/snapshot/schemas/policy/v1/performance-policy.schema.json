{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfeng.dev/schemas/policy/v1/performance-policy.schema.json",
  "$defs": {
    "id": {
      "type": "string",
      "description": "a string matching the pattern ^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "description": "a string matching the pattern ^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "metricSelector": {
      "type": "object",
      "required": [
        "name",
        "statistic",
        "unit"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Metric name following naming convention",
          "title": "minLength(1)",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.]*$"
        },
        "statistic": {
          "type": "string",
          "enum": [
            "mean",
            "median",
            "p90",
            "p95",
            "p99",
            "min",
            "max"
          ]
        },
        "unit": {
          "type": "string",
          "description": "a string matching the pattern \\S",
          "title": "minLength(1)",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": [
        "performance.perfeng.io/v1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "PerformancePolicy"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "version",
        "owner"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "owner": {
          "type": "string",
          "description": "a string matching the pattern \\S",
          "title": "minLength(1)",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": [
        "mode",
        "missingData",
        "rules"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "observe",
            "inform"
          ]
        },
        "missingData": {
          "type": "string",
          "enum": [
            "inconclusive"
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "id",
                  "metric",
                  "slo"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "metric": {
                    "$ref": "#/$defs/metricSelector"
                  },
                  "quality": {
                    "type": "object",
                    "required": [],
                    "properties": {
                      "minSamples": {
                        "type": "integer",
                        "description": "a number greater than or equal to 1",
                        "title": "greaterThanOrEqualTo(1)",
                        "minimum": 1
                      },
                      "maxCv": {
                        "type": "number",
                        "description": "a non-negative number",
                        "title": "greaterThanOrEqualTo(0)",
                        "minimum": 0
                      }
                    },
                    "additionalProperties": false,
                    "minProperties": 1
                  },
                  "slo": {
                    "type": "object",
                    "required": [],
                    "properties": {
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false,
                    "minProperties": 1
                  },
                  "regression": {
                    "type": "object",
                    "required": [
                      "direction",
                      "practicalDifference",
                      "reference"
                    ],
                    "properties": {
                      "direction": {
                        "type": "string",
                        "enum": [
                          "lower-is-better",
                          "higher-is-better"
                        ]
                      },
                      "practicalDifference": {
                        "type": "object",
                        "required": [
                          "kind",
                          "value"
                        ],
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "relative",
                              "absolute"
                            ]
                          },
                          "value": {
                            "type": "number",
                            "description": "a positive number",
                            "title": "greaterThan(0)",
                            "exclusiveMinimum": 0
                          }
                        },
                        "additionalProperties": false
                      },
                      "reference": {
                        "type": "object",
                        "required": [
                          "baselineId",
                          "version"
                        ],
                        "properties": {
                          "baselineId": {
                            "$ref": "#/$defs/id"
                          },
                          "version": {
                            "$ref": "#/$defs/version"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "metric",
                  "regression"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "metric": {
                    "$ref": "#/$defs/metricSelector"
                  },
                  "quality": {
                    "type": "object",
                    "required": [],
                    "properties": {
                      "minSamples": {
                        "type": "integer",
                        "description": "a number greater than or equal to 1",
                        "title": "greaterThanOrEqualTo(1)",
                        "minimum": 1
                      },
                      "maxCv": {
                        "type": "number",
                        "description": "a non-negative number",
                        "title": "greaterThanOrEqualTo(0)",
                        "minimum": 0
                      }
                    },
                    "additionalProperties": false,
                    "minProperties": 1
                  },
                  "slo": {
                    "type": "object",
                    "required": [],
                    "properties": {
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false,
                    "minProperties": 1
                  },
                  "regression": {
                    "type": "object",
                    "required": [
                      "direction",
                      "practicalDifference",
                      "reference"
                    ],
                    "properties": {
                      "direction": {
                        "type": "string",
                        "enum": [
                          "lower-is-better",
                          "higher-is-better"
                        ]
                      },
                      "practicalDifference": {
                        "type": "object",
                        "required": [
                          "kind",
                          "value"
                        ],
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "relative",
                              "absolute"
                            ]
                          },
                          "value": {
                            "type": "number",
                            "description": "a positive number",
                            "title": "greaterThan(0)",
                            "exclusiveMinimum": 0
                          }
                        },
                        "additionalProperties": false
                      },
                      "reference": {
                        "type": "object",
                        "required": [
                          "baselineId",
                          "version"
                        ],
                        "properties": {
                          "baselineId": {
                            "$ref": "#/$defs/id"
                          },
                          "version": {
                            "$ref": "#/$defs/version"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "uniqueItems": true,
          "description": "an array of at least 1 item(s)",
          "title": "minItems(1)",
          "minItems": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "title": "Versioned non-blocking performance policy"
}
